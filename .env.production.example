# Production settings for the EC2 deployment. Copy to .env on the server and fill in the secrets:
#   cp .env.production.example .env
# Then: docker compose --profile app up -d --build        (see docs/EC2-SETUP.md)
# .env is git-ignored. Never commit real values.

# ---- PORTS: every port the deployment uses (change here, then `docker compose --profile app up -d`) ----
# Web app, frontend AND backend: it is one Next.js process, so pages and /api share this port. This is the port you
# open in the browser and in the EC2 security group.
APP_PORT=3000
APP_BIND=0.0.0.0
# Postgres on the HOST. Containers always reach it internally as postgres:5432. Keep it on 127.0.0.1 on EC2 and never
# open it in the security group.
POSTGRES_PORT=5432
POSTGRES_BIND=127.0.0.1
# nginx on the host, only with --profile tls (8080/8443 because 80/443 are often taken; then set APP_BIND=127.0.0.1 so only nginx reaches the app).
HTTP_PORT=8080
HTTPS_PORT=8443
NGINX_BIND=0.0.0.0

# ---- Postgres (runs in Docker, reached by the app as host "postgres") ----
POSTGRES_USER=kr_app
# Use hex so it is safe inside the connection URL:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
POSTGRES_PASSWORD=
POSTGRES_DB=knowledge_review_final

# ---- Cookies and time ----
# false = served over plain http (login cookies work over http). true = served over https; REQUIRED then.
COOKIE_SECURE=false
# true ONLY when the app is reached through nginx (tls profile) or another proxy that sets X-Real-IP. Otherwise client IPs are
# treated as unknown and per-IP login/sign-up limits are off (the headers can be forged on a direct connection).
TRUSTED_PROXY=false
APP_TIMEZONE=Asia/Kolkata

# ---- First admin: created on the first start only, an existing admin is never overwritten ----
# Change the password in the app (Admin > Users) after the first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin@123

# ---- Login tokens ----
# REQUIRED, 32+ random characters, different on every server:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
REFRESH_IDLE_DAYS=7
REFRESH_GRACE_SECONDS=10

# ---- Email (one-time codes: add/verify an email, change or reset a password, sign in with a code) ----
# Email is NOT configured in this file. An admin adds the SMTP connection (Gmail, Outlook / Microsoft 365, SES ...) under
# Admin > Settings & exports > Email, tests it and presses Use. The password is stored encrypted in the database, using
# OTP_SECRET below as the key, so keep OTP_SECRET stable: if it changes, saved passwords must be entered again.
# Without an active connection, development prints the code in the `npm run dev` console instead of emailing it.
#
# OTP_SECRET: random 32+ characters. It hashes the one-time codes and encrypts the saved SMTP password.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
OTP_SECRET=

# ---- Knowledge Assistant ----
CHAT_ENABLED=true
CLAUDE_RUNNER=sdk
CLAUDE_MODEL=
# Claude credentials inside the container (there is no `claude login` there). Set ONE of:
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
# Knowledge-base MCP server. Use a host name that matches its TLS certificate, or the answers fail with "kb_unavailable".
KG_MCP_URL=https://your-mcp-host/mcp
KG_MCP_TOKEN=
# Optional second knowledge base "SpectrumERP-new" (docs/plans/PLAN-kg-mcp-new.md). Leave the URL empty to hide it.
# The token decides the role on that server: product chats use the technical token. Never commit real tokens.
KG_NEW_MCP_URL=
KG_NEW_MCP_TOKEN_TECHNICAL=
KG_NEW_MCP_TOKEN_FUNCTIONAL=
MAX_CONCURRENT_CLAUDE=3
CHAT_TIMEOUT_SECONDS=120
CHAT_MAX_TURNS=16
# Limits for SpectrumERP-new chats (measured, docs/CHAT-HARNESS.md §6); empty = CHAT_TIMEOUT_SECONDS / CHAT_MAX_TURNS.
CHAT_NEW_TIMEOUT_SECONDS=120
CHAT_NEW_MAX_TURNS=30
CHAT_DAILY_LIMIT=100
CHAT_MAX_QUESTION_CHARS=4000
CHAT_ALLOW_WEB=true

# ---- Intent classifier (jev) — docs/INTENT-CLASSIFIER.md ----
# Every question is checked by TypeSafe AI's jev decision model before Claude runs. Off by default: false = no change at all.
# Enabled with an empty CLASSIFIER_API_KEY counts as off. Roll out with CLASSIFIER_MODE=shadow first, then enforce.
# CLASSIFIER_ENABLED=false
# shadow = log only, never block (classifier failures never block) | enforce = flagged questions are refused
# CLASSIFIER_MODE=shadow
# CLASSIFIER_TIMEOUT_MS=3000
# CLASSIFIER_API_KEY=
# CLASSIFIER_MODEL=jev-1.14.0
# CLASSIFIER_BASE_URL=https://api.typesafe.ai/v1/systemone
# Per-check probability at or above which a question is flagged (default 0.5 each). JSON, keys: sql_injection,
# jailbreak, out_of_domain, restricted_object. Example: {"jailbreak":0.4,"out_of_domain":0.7}
# CLASSIFIER_THRESHOLDS=
