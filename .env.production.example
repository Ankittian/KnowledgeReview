# Production settings for the EC2 deployment. Copy to .env on the server and fill in the secrets:
#   cp .env.production.example .env
# Then: docker compose --profile app up -d --build        (see docs/EC2-SETUP.md)
# .env is git-ignored. Never commit real values.

# ---- PORTS: every port the deployment uses (change here, then `docker compose --profile app up -d`) ----
# Web app, frontend AND backend: it is one Next.js process, so pages and /api share this port. This is the port you
# open in the browser and in the EC2 security group.
APP_PORT=3000
APP_BIND=0.0.0.0
# Postgres on the HOST. Containers always reach it internally as postgres:5432. Keep it on 127.0.0.1 on EC2 and never
# open it in the security group.
POSTGRES_PORT=5432
POSTGRES_BIND=127.0.0.1
# nginx on the host, only with --profile tls (8080/8443 because 80/443 are often taken; then set APP_BIND=127.0.0.1 so only nginx reaches the app).
HTTP_PORT=8080
HTTPS_PORT=8443
NGINX_BIND=0.0.0.0

# ---- Postgres (runs in Docker, reached by the app as host "postgres") ----
POSTGRES_USER=kr_app
# Use hex so it is safe inside the connection URL:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
POSTGRES_PASSWORD=
POSTGRES_DB=knowledge_review_final

# ---- Cookies and time ----
# false = served over plain http (login cookies work over http). true = served over https; REQUIRED then.
COOKIE_SECURE=false
APP_TIMEZONE=Asia/Kolkata

# ---- First admin: created on the first start only, an existing admin is never overwritten ----
# Change the password in the app (Admin > Users) after the first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin@123

# ---- Login tokens ----
# REQUIRED, 32+ random characters, different on every server:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
REFRESH_IDLE_DAYS=7
REFRESH_GRACE_SECONDS=10

# ---- Knowledge Assistant ----
CHAT_ENABLED=true
CLAUDE_RUNNER=sdk
CLAUDE_MODEL=
# Claude credentials inside the container (there is no `claude login` there). Set ONE of:
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
# Knowledge-base MCP server. Use a host name that matches its TLS certificate, or the answers fail with "kb_unavailable".
KG_MCP_URL=https://your-mcp-host/mcp
KG_MCP_TOKEN=
MAX_CONCURRENT_CLAUDE=3
CHAT_TIMEOUT_SECONDS=120
CHAT_MAX_TURNS=16
CHAT_DAILY_LIMIT=100
CHAT_MAX_QUESTION_CHARS=4000
CHAT_ALLOW_WEB=true
