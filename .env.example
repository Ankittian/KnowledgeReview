# Managed Postgres (Neon / Supabase). Leave empty to use embedded PGlite in ./.data/pglite for local dev.
# Supabase: use the "Session pooler" or direct connection string. Neon: the pooled connection string works.
DATABASE_URL=

# Where the knowledge-base YAML snapshot lives (modules.yaml, concepts.yaml, rules.yaml, processes/, forms/).
KB_DIR=./kb

# First admin, used by `npm run seed:admin` (or pass --username / --password).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Set to "true" when serving over HTTPS (production) so the session cookie is Secure.
COOKIE_SECURE=false
