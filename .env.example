# ---- Postgres (Docker) ----
# `npm run db:up` starts the container from docker-compose.yml. These three are read by docker compose.
POSTGRES_USER=kr_app
POSTGRES_PASSWORD=change-me-use-a-long-random-password
POSTGRES_DB=knowledge_review_final
POSTGRES_PORT=5439

# REQUIRED. Must use the same user, password, port and database as above.
DATABASE_URL=postgresql://kr_app:change-me-use-a-long-random-password@localhost:5439/knowledge_review_final
# Throw-away databases (they are wiped on every run). The names must contain "test" / "e2e".
TEST_DATABASE_URL=postgresql://kr_app:change-me-use-a-long-random-password@localhost:5439/knowledge_review_unittest
E2E_DATABASE_URL=postgresql://kr_app:change-me-use-a-long-random-password@localhost:5439/knowledge_review_e2e
DB_POOL_MAX=5

# Where the knowledge-base YAML snapshot lives (modules.yaml, concepts.yaml, rules.yaml, processes/, forms/).
KB_DIR=./kb

# Time zone for "today" (daily decks, streaks, the weekly leaderboard). IANA name; default Asia/Kolkata.
APP_TIMEZONE=Asia/Kolkata

# Dev only: extra hostnames allowed to open `next dev` (comma separated), e.g. a phone on your LAN. LAN IPs are detected automatically.
LAN_DEV_ORIGINS=

# Flashcard catalogs for `npm run cards:push` live in data/generated-cards/ (no setting needed; pass file paths to override).

# First admin, used by `npm run seed:admin` (or pass --username / --password).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Set to "true" when serving over HTTPS (production) so the session cookies are Secure.
COOKIE_SECURE=false

# ---- Login tokens (JWT access token + rotating refresh token) ----
# What is stored where:
#   - Passwords: Postgres `users.password_hash` (argon2id).
#   - Login sessions and refresh tokens: Postgres `sessions` / `refresh_tokens` (refresh tokens as SHA-256 hashes only).
#   - Access JWTs: not stored (stateless, short-lived, HttpOnly cookie).
#   - The JWT signing key below is the ONLY auth secret kept outside the database. Keep it out of Postgres on purpose:
#     a key stored beside the sessions it protects would let a database leak forge logins.
#
# REQUIRED: random string, 32+ characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Never commit it. In production inject it from AWS SSM Parameter Store / Secrets Manager (not a file in the repo).
# Changing it logs everyone out. To rotate without logging people out, move the old value to JWT_SECRET_PREVIOUS,
# set a new JWT_SECRET, and clear JWT_SECRET_PREVIOUS after ACCESS_TOKEN_MINUTES have passed.
JWT_SECRET=
JWT_SECRET_PREVIOUS=
ACCESS_TOKEN_MINUTES=15
# Absolute life of a login, and how long a login may sit unused. Expired sessions are purged at the next sign-in.
REFRESH_TOKEN_DAYS=30
REFRESH_IDLE_DAYS=7
# Parallel tabs may refresh with the same token inside this window without being logged out.
REFRESH_GRACE_SECONDS=10

# ---- Knowledge Assistant (chat): PDF sections 3, 5, 6 ----
CHAT_ENABLED=true
# sdk = Claude Agent SDK (Claude Code engine); mock = canned answers for tests / offline dev.
CLAUDE_RUNNER=sdk
# Empty = Claude Code's default model. Example: claude-opus-5-5
CLAUDE_MODEL=
# Claude credentials for the harness (pick one; see docs/CHAT-HARNESS.md for the licence note):
#   ANTHROPIC_API_KEY=...          API key (recommended by Anthropic for multi-user products)
#   CLAUDE_CODE_OAUTH_TOKEN=...    subscription token from `claude setup-token`
# Neither set = the server user's existing `claude login`.
# Optional: dedicated Claude config dir (credentials + session transcripts) for the harness user.
CLAUDE_CONFIG_DIR=
# Working directory with ONLY .claude/settings.json and the role skills. Default: ./claude-harness
CLAUDE_HARNESS_DIR=
# Knowledge-base MCP server (streamable HTTP) and its bearer token. Never commit the real token.
KG_MCP_URL=https://<mcp-host>/mcp
KG_MCP_TOKEN=
MAX_CONCURRENT_CLAUDE=3
CHAT_TIMEOUT_SECONDS=120
CHAT_MAX_TURNS=16
CHAT_DAILY_LIMIT=100
CHAT_MAX_QUESTION_CHARS=4000
CHAT_ALLOW_WEB=true
