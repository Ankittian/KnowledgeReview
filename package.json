{
  "name": "knowledge-review",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Daily flashcards that verify the SpectrumERP functional knowledge base and measure employee knowledge.",
  "scripts": {
    "dev": "next dev --turbo",
    "dev:lan": "next dev --turbo -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start",
    "start:lan": "next start -H 0.0.0.0 -p 3000",
    "typecheck": "tsc --noEmit",
    "db:init": "tsx scripts/db-init.ts",
    "db:export-schema": "node scripts/export-schema.mjs",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:setup": "tsx scripts/db-init.ts && tsx scripts/sync-cards.ts && tsx scripts/seed-admin.ts --if-missing",
    "db:studio": "drizzle-kit studio",
    "db:query": "tsx scripts/query.ts",
    "kb:import": "tsx scripts/import-kb.ts",
    "cards:sync": "tsx scripts/sync-cards.ts",
    "cards:push": "tsx scripts/push-cards.ts",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "report:needs-change": "tsx scripts/report-needs-change.ts",
    "test": "vitest run",
    "e2e": "playwright test",
    "postinstall": "node -e \"const fs = require('fs'); const p = 'node_modules/tw-animate-css/package.json'; if (fs.existsSync(p)) { const j = JSON.parse(fs.readFileSync(p, 'utf8')); if (j.exports && j.exports['.'] && !j.exports['.'].default) { j.exports['.'].default = j.exports['.'].style; j.exports['.'].import = j.exports['.'].style; fs.writeFileSync(p, JSON.stringify(j, null, 2)); } }\"",
    "chat:check": "tsx scripts/chat-check.ts",
    "deploy:init": "tsx scripts/db-init.ts && tsx scripts/seed-admin.ts --if-missing && tsx scripts/sync-cards.ts --entities-only && tsx scripts/push-cards.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.323",
    "@base-ui/react": "1.9.0",
    "@node-rs/argon2": "2.2.2",
    "@number-flow/react": "0.6.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "drizzle-orm": "0.45.4",
    "jose": "^6.1.0",
    "lucide-react": "1.70.0",
    "motion": "14.9.1",
    "next": "16.4.5",
    "next-themes": "0.4.6",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "recharts": "^3.8.0",
    "remark-gfm": "4.0.1",
    "shadcn": "^4.23.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
