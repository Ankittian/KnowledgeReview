{
  "name": "knowledge-review",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Daily flashcards that verify the SpectrumERP functional knowledge base and measure employee knowledge.",
  "scripts": {
    "dev": "next dev",
    "dev:lan": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start",
    "start:lan": "next start -H 0.0.0.0 -p 3000",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:setup": "tsx scripts/migrate.ts && tsx scripts/sync-cards.ts && tsx scripts/seed-admin.ts",
    "db:studio": "drizzle-kit studio",
    "db:query": "tsx scripts/query.ts",
    "kb:import": "tsx scripts/import-kb.ts",
    "cards:sync": "tsx scripts/sync-cards.ts",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "report:needs-change": "tsx scripts/report-needs-change.ts",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@node-rs/argon2": "2.2.2",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.70.0",
    "motion": "14.9.1",
    "next": "16.4.5",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
